{
  "compilerOptions": {
    // =========================
    // Project Structure
    // =========================

    "rootDir": "./src",
    "outDir": "./dist",

    // =========================
    // Runtime (Node ESM)
    // =========================

    "module": "nodenext",
    "target": "esnext",

    // =========================
    // Node environment support
    // =========================

    "types": ["node"],

    // =========================
    // Build outputs
    // =========================

    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    // =========================
    // Type safety 
    // =========================

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    // =========================
    // Module behavior
    // =========================

    "verbatimModuleSyntax": true,
    "isolatedModules": true,

    
    "moduleDetection": "force",
    "skipLibCheck": true
  }
}